{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pull email by subject",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["-r", "ts-node/register/transpile-only"],
      "program": "${workspaceFolder}/src/scripts/pull-emails.ts",
      "args": ["--channel", "${input:channel}", "--subject", "${input:subject}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Get Gmail refresh token",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["-r", "ts-node/register/transpile-only"],
      "program": "${workspaceFolder}/src/scripts/gmail-token.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Start API server (dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["-r", "ts-node/register/transpile-only"],
      "program": "${workspaceFolder}/src/server.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "inputs": [
    {
      "id": "channel",
      "type": "pickString",
      "description": "Channel",
      "options": ["zepto"],
      "default": "zepto"
    },
    {
      "id": "subject",
      "type": "promptString",
      "description": "Exact email subject, e.g. Purchase Order for [PEP TECHNOLOGIES PRIVATE LIMITED and P5691383]"
    }
  ]
}
