# Settings for `npm test` ONLY (2026-10-28). Committed on purpose: NO real secret may ever be here.
# test/setup/env.ts loads this BEFORE the app reads .env, so these win; any other key of the real .env is blanked.
# The DB login comes from .env.test (laptop, git-ignored) or the CI job (TEST_DB_*). The DB guard refuses anything but
# mcaff_postfg_test on 127.0.0.1 / localhost while NODE_ENV=test.
NODE_ENV=test
PORT=0
API_PREFIX=/api/v1
LOG_LEVEL=error
LOG_FORMAT=text
DB_ENABLED=true
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_POOL_SIZE=5
DB_QUERY_TIMEOUT_MS=20000
MONITOR_SECONDS=0
MONITOR_HEARTBEAT_MINUTES=0

# login (fake keys: tokens are signed and checked locally only)
AUTH_SECRET=test-only-auth-secret-not-used-anywhere-else-0123456789
AUTH_CACHE_SECONDS=0
SESSION_DAYS=7
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
AUTH_CALLBACK_URL=http://localhost/api/v1/auth/google/callback
AUTH_REDIRECT_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=mcaffeine.com
GOOGLE_CLIENT_ID=test-google-client
GOOGLE_CLIENT_SECRET=test-google-secret

# every background job and outside service OFF
PUBSUB_ENABLED=false
OCR_ENABLED=false
OCR_BACKLOG=false
OCR_RUN_LIMIT=0
PIPELINE_RESUME=false
PIPELINE_LIMIT=0
CHANNEL_API_ENABLED=false
LOCAL_CLEANUP_ENABLED=false
WORKER_IN_SERVER=false
QUEUE_MODE=local
RECHECK_MINUTES=0
LAPTOP_MODE=false
PO_VERIFY_REQUIRED=true
INTAKE_BASE_URL=http://127.0.0.1:9/api/v1
WEBHOOK_SECRET=test-webhook-secret

# storage: a throwaway folder under test/ (git-ignored)
EMAIL_STORAGE_DIR=test/.tmp/storage/emails
GMAIL_STATE_FILE=test/.tmp/storage/gmail-state.json
INTRANSIT_DIR=test/.tmp/storage/intransit
INTRANSIT_S3_ENABLED=false
INTRANSIT_TEST=true

# AWS / Google / Amazon / Uniware: dummy values; real calls are also blocked by the network guard (test/setup/env.ts)
# S3 on, backed by the in-memory fake bucket (test/helpers/fake-s3.ts): the review reads PO files from S3 only
S3_ENABLED=true
S3_BUCKET=postfg-test-bucket-does-not-exist
S3_REGION=ap-south-1
S3_EMAIL_PREFIX=test/
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test-not-a-key
AWS_SECRET_ACCESS_KEY=test-not-a-secret
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_ENDPOINT_URL=http://127.0.0.1:9
SQS_PO_JOBS_ARN=arn:aws:sqs:ap-south-1:000000000000:test-po-jobs
SQS_PO_JOBS_DLQ_ARN=arn:aws:sqs:ap-south-1:000000000000:test-po-jobs-dlq
GMAIL_AUTH_MODE=oauth
GMAIL_MAILBOX=test-mailbox@mcaffeine.com
GMAIL_OAUTH_CLIENT_ID=test-gmail-client
GMAIL_OAUTH_CLIENT_SECRET=test-gmail-secret
GMAIL_OAUTH_REFRESH_TOKEN=test-gmail-refresh
GMAIL_SERVICE_ACCOUNT_KEY_FILE=
GCP_PROJECT_ID=test-project
PUBSUB_TOPIC=test-topic
PUBSUB_SUBSCRIPTION=test-subscription
PUBSUB_KEY_FILE=
SPAPI_CLIENT_ID=test-spapi-client
SPAPI_CLIENT_SECRET=test-spapi-secret
SPAPI_REFRESH_TOKEN=test-spapi-refresh
SPAPI_REGION=eu
UNIWARE_TENANT=
UNIWARE_USERNAME=
UNIWARE_PASSWORD=
UNIWARE_FACILITY=
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
PYTHON_BIN=python-not-used-in-tests
OCR_SCRIPT=not-used-in-tests
