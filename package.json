{
  "name": "post-fg",
  "version": "1.0.0",
  "description": "POST_FG - PO platform backend",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "gmail:token": "ts-node --transpile-only src/scripts/gmail-token.ts",
    "email:route": "ts-node --transpile-only src/scripts/route-label.ts",
    "email:sort": "ts-node --transpile-only src/scripts/sort-emails.ts",
    "s3:sync": "ts-node --transpile-only src/scripts/s3-sync.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "ocr:run": "ts-node --transpile-only src/scripts/ocr-run.ts",
    "po:process": "ts-node --transpile-only src/scripts/po-process.ts",
    "po:validate": "ts-node --transpile-only src/scripts/po-validate.ts",
    "po:record": "ts-node --transpile-only src/scripts/po-record.ts",
    "po:save": "ts-node --transpile-only src/scripts/po-save.ts",
    "po:pipeline": "ts-node --transpile-only src/scripts/po-pipeline.ts",
    "po:one": "ts-node --transpile-only src/scripts/po-one.ts",
    "po:resume": "ts-node --transpile-only src/scripts/po-resume.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@google-cloud/pubsub": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^182.0.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
