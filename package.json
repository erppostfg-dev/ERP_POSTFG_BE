{
  "name": "post-fg",
  "version": "1.0.0",
  "description": "POST_FG - PO platform backend",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/dev.ts",
    "dev:full": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:prune": "eslint src --prune-suppressions",
    "deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "knip": "knip",
    "test:related": "vitest related --run",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run knip && npm test",
    "prepare": "node -e \"import('./.husky/install.mjs').catch(() => {})\"",
    "gmail:token": "ts-node --transpile-only src/scripts/gmail-token.ts",
    "email:route": "ts-node --transpile-only src/scripts/route-label.ts",
    "email:sort": "ts-node --transpile-only src/scripts/sort-emails.ts",
    "s3:sync": "ts-node --transpile-only src/scripts/s3-sync.ts",
    "storage:cleanup": "ts-node --transpile-only src/scripts/storage-cleanup.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/config/data-source.ts",
    "ocr:run": "ts-node --transpile-only src/scripts/ocr-run.ts",
    "po:process": "ts-node --transpile-only src/scripts/po-process.ts",
    "po:validate": "ts-node --transpile-only src/scripts/po-validate.ts",
    "po:record": "ts-node --transpile-only src/scripts/po-record.ts",
    "po:save": "ts-node --transpile-only src/scripts/po-save.ts",
    "po:pipeline": "ts-node --transpile-only src/scripts/po-pipeline.ts",
    "po:one": "ts-node --transpile-only src/scripts/po-one.ts",
    "po:resume": "ts-node --transpile-only src/scripts/po-resume.ts",
    "auth:seed": "ts-node --transpile-only src/scripts/auth-seed.ts",
    "masters:load": "ts-node --transpile-only src/scripts/masters-load.ts",
    "masters:replace": "ts-node --transpile-only src/scripts/masters-replace.ts",
    "po:brand-fill": "ts-node --transpile-only src/scripts/brand-fill.ts",
    "masters:link": "ts-node --transpile-only src/scripts/masters-link.ts",
    "auth:user": "ts-node --transpile-only src/scripts/auth-user.ts",
    "amazon:check": "ts-node --transpile-only src/scripts/channel-api.ts check amazon_spapi",
    "amazon:pull": "ts-node --transpile-only src/scripts/channel-api.ts pull amazon_spapi",
    "sale-orders:prefix": "ts-node --transpile-only src/scripts/sale-order-prefix.ts",
    "amazon:inbound": "ts-node --transpile-only src/scripts/amazon-inbound.ts",
    "intransit:run": "ts-node --transpile-only src/scripts/intransit-run.ts",
    "intransit:fetch": "ts-node --transpile-only src/scripts/intransit-fetch.ts",
    "intransit:pepims": "ts-node --transpile-only src/scripts/intransit-pepims.ts",
    "intransit:masters": "ts-node --transpile-only src/scripts/intransit-masters.ts",
    "intransit:compare": "ts-node --transpile-only src/scripts/intransit-compare.ts",
    "intransit:s3-migrate": "ts-node --transpile-only src/scripts/intransit-s3-migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@google-cloud/pubsub": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "google-auth-library": "^11.2.0",
    "googleapis": "^182.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint --max-warnings 0 --no-warn-ignored"
  }
}
