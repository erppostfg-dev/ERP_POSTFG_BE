NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# true once MySQL is set up; false starts the server without a database
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=post_fg
# Keep false. Use migrations to change the schema.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Logging (src/constants/logging.ts; see LOGGING.md in the workspace). EC2: LOG_FORMAT=json (CloudWatch agent).
LOG_LEVEL=info
LOG_FORMAT=pretty
# Slow limits in ms (0 = off): SQL query, API request, call to another service, background job.
DB_SLOW_MS=500
API_SLOW_MS=2000
EXT_SLOW_MS=3000
JOB_SLOW_MS=300000
# Waste checks: queries per request, response size (KB), same call repeated in one request.
DB_QUERIES_WARN=100
RESPONSE_WARN_KB=5120
REPEAT_WARN=3
# Process health: event loop blocked (ms), memory RSS (MB), check every N s, heartbeat every N min (0 = off).
EVENT_LOOP_WARN_MS=200
MEMORY_WARN_MB=1024
MONITOR_SECONDS=15
MONITOR_HEARTBEAT_MINUTES=5

# Gmail mailbox that receives the supplyPO@ group mail
GMAIL_MAILBOX=erp.postfg@mcaffeine.com
# oauth (refresh token of the mailbox, get it with: npm run gmail:token) | service_account (domain-wide delegation)
GMAIL_AUTH_MODE=oauth
GMAIL_SERVICE_ACCOUNT_KEY_FILE=secrets/gmail-service-account.json
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Where pulled emails and attachments are saved
EMAIL_STORAGE_DIR=storage/emails
# Only used until the LocalStorageDb migration: then the Gmail sync point lives in the DB (app_state).
GMAIL_STATE_FILE=storage/gmail-state.json
# Remove finished emails' local folders once every file is confirmed in S3 (prod: true; dry run: npm run storage:cleanup)
LOCAL_CLEANUP_ENABLED=false

# Shared secret for POST /po-intake/email (header X-Webhook-Secret)
WEBHOOK_SECRET=
# Where label routes send emails (relative endpoints are joined to this)
INTAKE_BASE_URL=http://localhost:3000/api/v1

# Gmail watch -> Pub/Sub. true starts the listener with the server.
PUBSUB_ENABLED=false
GCP_PROJECT_ID=
# Topic and pull-subscription ids (not the full projects/... path)
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=
# Optional service account key for Pub/Sub; empty = reuse the Gmail OAuth login
PUBSUB_KEY_FILE=

# Python OCR (ocr-service/). true = run extractPo() on every newly stored email (testing).
OCR_ENABLED=false
# true: the OCR reads its input files from the S3 copy instead of the local folder (needs S3_ENABLED)
OCR_INPUT_FROM_S3=false
# true: at startup, stored POs without ocr-result.json are queued too (oldest first)
OCR_BACKLOG=false
# most OCR runs per server start (new + backlog); 0 = no limit; the rest waits for the next start
OCR_RUN_LIMIT=0
# Python with the OCR packages: .venv-ocr/Scripts/python.exe (Windows) or .venv-ocr/bin/python (EC2)
PYTHON_BIN=python
OCR_SCRIPT=ocr-service/dev/scripts/run_po.py
OCR_TIMEOUT_MS=600000
OCR_CONCURRENCY=2

# PO chain after intake (po_uploads -> OCR -> processed.json -> validation -> DB -> Uniware CSV)
# most emails taken into the chain per start (new + resumed); 0 = no limit (production). Over the limit: stored as files only.
PIPELINE_LIMIT=0
# PO verification before the Uniware CSV (2026-10-22): true = a processed PO's CSV is locked until someone verifies it
# against the original PO (Processed tab -> Verify). false = the step is off.
PO_VERIFY_REQUIRED=true
# Re-check of POs in review after a master fix: minutes between runs (0 = only the button + after masters:load).
RECHECK_MINUTES=30
# true: at server start, unfinished po_uploads rows are resumed (queued / extracting / processing)
PIPELINE_RESUME=false

# AWS (OCR: Bedrock, Textract, S3). On EC2 use an instance role instead of keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# S3 copy of the email storage (same layout as storage/emails); credentials from AWS_* or the EC2 IAM role
S3_ENABLED=false
S3_BUCKET=mcaffeine-erp-post-fg-s3-dev
S3_EMAIL_PREFIX=

# Login: Google sign-in for the POST_FG website. A "Web application" OAuth client in the Google Cloud project
# (audience Internal), not the Gmail reading client above (GMAIL_OAUTH_*).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie: a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Must also be listed as an Authorized redirect URI on the OAuth client
AUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Where the browser lands after login: /auth/me until the frontend runs, then the frontend URL
AUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/me
# The frontend's address (CORS with credentials); also an Authorized JavaScript origin on the OAuth client
FRONTEND_ORIGIN=http://localhost:5173
# Only accounts of this Google domain may log in
ALLOWED_EMAIL_DOMAIN=mcaffeine.com
SESSION_DAYS=7
# true in production (https only)
COOKIE_SECURE=false

# PO jobs queue (2026-10-26): local = in-process as before; sqs = jobs go to SQS, the worker runs them one at a time.
QUEUE_MODE=local
SQS_PO_JOBS_ARN=
SQS_PO_JOBS_DLQ_ARN=
WORKER_CONCURRENCY=1
WORKER_PAUSE_MS=1000
# true = the API server also runs the worker (one process); false = run `npm run worker` separately.
WORKER_IN_SERVER=false
