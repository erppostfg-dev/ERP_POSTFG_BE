NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# true once MySQL is set up; false starts the server without a database
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=post_fg
# Keep false. Use migrations to change the schema.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Gmail mailbox that receives the supplyPO@ group mail
GMAIL_MAILBOX=erp.postfg@mcaffeine.com
# oauth (refresh token of the mailbox, get it with: npm run gmail:token) | service_account (domain-wide delegation)
GMAIL_AUTH_MODE=oauth
GMAIL_SERVICE_ACCOUNT_KEY_FILE=secrets/gmail-service-account.json
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Where pulled emails and attachments are saved
EMAIL_STORAGE_DIR=storage/emails
GMAIL_STATE_FILE=storage/gmail-state.json

# Shared secret for POST /po-intake/email (header X-Webhook-Secret)
WEBHOOK_SECRET=
# Where label routes send emails (relative endpoints are joined to this)
INTAKE_BASE_URL=http://localhost:3000/api/v1

# Gmail watch -> Pub/Sub. true starts the listener with the server.
PUBSUB_ENABLED=false
GCP_PROJECT_ID=
# Topic and pull-subscription ids (not the full projects/... path)
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=
# Optional service account key for Pub/Sub; empty = reuse the Gmail OAuth login
PUBSUB_KEY_FILE=

# Python OCR (ocr-service/). true = run extractPo() on every newly stored email (testing).
OCR_ENABLED=false
# true: the OCR reads its input files from the S3 copy instead of the local folder (needs S3_ENABLED)
OCR_INPUT_FROM_S3=false
# true: at startup, stored POs without ocr-result.json are queued too (oldest first)
OCR_BACKLOG=false
# most OCR runs per server start (new + backlog); 0 = no limit; the rest waits for the next start
OCR_RUN_LIMIT=0
# Python with the OCR packages: .venv-ocr/Scripts/python.exe (Windows) or .venv-ocr/bin/python (EC2)
PYTHON_BIN=python
OCR_SCRIPT=ocr-service/dev/scripts/run_po.py
OCR_TIMEOUT_MS=600000
OCR_CONCURRENCY=2

# AWS (OCR: Bedrock, Textract, S3). On EC2 use an instance role instead of keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# S3 copy of the email storage (same layout as storage/emails); credentials from AWS_* or the EC2 IAM role
S3_ENABLED=false
S3_BUCKET=mcaffeine-erp-post-fg-s3-dev
S3_EMAIL_PREFIX=
